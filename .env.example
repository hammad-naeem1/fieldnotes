DEBUG=true
SECRET_KEY=replace-this-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC

# Leave DATABASE_URL empty for the persistent local SQLite database.
DATABASE_URL=

# Mail is printed to the terminal in development. Set all SMTP values in production.
DEFAULT_FROM_EMAIL=Fieldnotes <noreply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# For an S3-compatible private bucket such as Cloudflare R2 or AWS S3.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only set this to HTTP_X_FORWARDED_FOR when the app is behind a trusted proxy.
RATE_LIMIT_IP_HEADER=REMOTE_ADDR
ENABLE_HSTS=false
